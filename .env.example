# ตั้งค่าเหล่านี้ใน Vercel > Project > Settings > Environment Variables (ห้ามใส่ค่าจริงในไฟล์นี้)

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (พอร์ต 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# คัดลอกจาก Apps Script ระบบลา > Project Settings > Script Properties (ค่าเดิม เพื่อให้ PIN/รหัสผ่านเดิมใช้ได้ และระบบอื่นไม่ต้องเปลี่ยนคีย์)
PEPPER=
STOCK_API_KEY=
INCIDENT_API_KEY=
RECORD_API_KEY=
BLOODGAS_API_KEY=
GLUCOSE_API_KEY=
ALLADMIN_API_KEY=

# LINE: เว้นว่างไว้ระหว่างทดสอบคู่ขนาน (กันแจ้งเตือนซ้ำกับระบบเดิม) ใส่ตอนย้ายจริง
LINE_CHANNEL_TOKEN=
LINE_WEBHOOK_KEY=

# (ไม่บังคับ) ใช้กับ /api/cron-line ถ้าตั้งบริการเรียกส่งคิว LINE ตามเวลา
CRON_SECRET=
